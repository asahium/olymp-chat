# === Provider (server-side only — NEVER exposed to the browser) ===
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it
MAX_OUTPUT_TOKENS=1000
TEMPERATURE=0.2
TOP_P=0.95

# === Input / conversation limits ===
MAX_INPUT_CHARS=50000
MAX_CONTEXT_MESSAGES=20

# === Per-participant rate limits & quota ===
RPM_PER_PARTICIPANT=5
RPH_PER_PARTICIPANT=100
TOTAL_REQUESTS_PER_PARTICIPANT=300

# === Auth ===
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=12

# === Storage ===
DATABASE_URL=sqlite:///./data/app.db
# Reserved for a future distributed rate limiter; unused in the MVP.
REDIS_URL=

# === Admin / serving ===
# Required for the /api/admin/* endpoints (sent as the X-Admin-Token header).
ADMIN_TOKEN=
# Comma-separated allowed origins; leave empty for same-origin (backend serves SPA).
CORS_ORIGINS=
